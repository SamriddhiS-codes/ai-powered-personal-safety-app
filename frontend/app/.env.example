# Copy this file to .env.local (which git ignores) and put your own values in it.
# Restart `npm run dev` after changing it.

# The id of a user row in YOUR database (SELECT id FROM users;)
VITE_USER_ID=put-your-test-user-id-here

# Only needed if the backend is not on localhost:8080
# VITE_API_URL=http://localhost:8080/api
